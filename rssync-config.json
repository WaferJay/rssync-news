{
    "archive-current-only": true,
    "concurrency": {
        "rss-downloads": 4,
        "webpage-downloads": 8,
        "per-domain-downloads": 2,
        "request-interval": 3
    },
    "rss": {
        "change-detection": {
            "ignore-tags": [
                "lastBuildDate"
            ]
        }
    },
    "webpages": {
        "storage-path": "pages",
        "refresh-policy": "always"
    },
    "downloaders": {
        "default": {
            "options": {
                "use-session": true,
                "timeout": 30,
                "retries": 3,
                "backoff-factor": 0.5,
                "verify-tls": true,
                "user-agent": {
                    "strategy": "per-run"
                }
            }
        }
    },
