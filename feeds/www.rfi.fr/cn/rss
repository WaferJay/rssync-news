</description><media:thumbnail url="https://s.rfi.fr/media/display/d3201f70-8fd1-11f1-ac1f-005056a90284/w:1024/p:16x9/24-7-%E5%BC%A0%E5%AE%B6%E5%8F%A3%E8%BF%BD%E8%B8%AA%E5%A4%96%E5%9B%BD%E4%BA%BA%E5%B9%B3%E5%8F%B0%E7%9A%84%E5%88%86%E7%B1%BB%E9%A2%87%E4%B8%BA%E4%BB%94%E7%BB%86-%E7%BA%BD%E7%BA%A6%E6%97%B6%E6%8A%A5-%E6%88%AA%E5%9B%BE.jpg"/><enclosure url="https://s.rfi.fr/media/display/d3201f70-8fd1-11f1-ac1f-005056a90284/w:1024/p:16x9/24-7-%E5%BC%A0%E5%AE%B6%E5%8F%A3%E8%BF%BD%E8%B8%AA%E5%A4%96%E5%9B%BD%E4%BA%BA%E5%B9%B3%E5%8F%B0%E7%9A%84%E5%88%86%E7%B1%BB%E9%A2%87%E4%B8%BA%E4%BB%94%E7%BB%86-%E7%BA%BD%E7%BA%A6%E6%97%B6%E6%8A%A5-%E6%88%AA%E5%9B%BE.jpg" type="image/jpeg" length="0"/><guid isPermaLink="false">0d709772-8fd2-11f1-aa37-8550b962ec54</guid><pubDate>Tue, 04 Aug 2026 06:59:45 GMT</pubDate><source url="https://s.rfi.fr/media/display/d3201f70-8fd1-11f1-ac1f-005056a90284/w:1024/p:16x9/24-7-%E5%BC%A0%E5%AE%B6%E5%8F%A3%E8%BF%BD%E8%B8%AA%E5%A4%96%E5%9B%BD%E4%BA%BA%E5%B9%B3%E5%8F%B0%E7%9A%84%E5%88%86%E7%B1%BB%E9%A2%87%E4%B8%BA%E4%BB%94%E7%BB%86-%E7%BA%BD%E7%BA%A6%E6%97%B6%E6%8A%A5-%E6%88%AA%E5%9B%BE.jpg">© (《纽约时报》截图)</source><dc:creator>香港特约记者 麦燕庭</dc:creator></item><item><category>要闻分析</category><title>二次软禁中的昂山素季首次得以会见红十字组织代表</title><link>https://www.rfi.fr/cn/%E4%B8%93%E6%A0%8F%E6%A3%80%E7%B4%A2/%E8%A6%81%E9%97%BB%E5%88%86%E6%9E%90/20260803-%E4%BA%8C%E6%AC%A1%E8%BD%AF%E7%A6%81%E4%B8%AD%E7%9A%84%E6%98%82%E5%B1%B1%E7%B4%A0%E5%AD%A3%E9%A6%96%E6%AC%A1%E5%BE%97%E4%BB%A5%E4%BC%9A%E8%A7%81%E7%BA%A2%E5%8D%81%E5%AD%97%E7%BB%84%E7%BB%87%E4%BB%A3%E8%A1%A8</link><description>
