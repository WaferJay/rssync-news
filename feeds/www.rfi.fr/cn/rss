/www.rfi.fr/cn/%E7%BE%8E%E6%B4%B2/20260724-%E7%BE%8E%E5%9B%BD%E4%BB%8A%E8%B5%B7%E7%BB%AD%E5%90%9160%E5%9B%BD%E5%BE%B510-%E8%87%B312-5-%E5%85%B3%E7%A8%8E-%E4%B8%AD%E6%B8%AF%E5%8F%97%E7%B4%AF-%E5%A4%9A%E5%9B%BD%E5%8F%8D%E5%AF%B9</link><description>
